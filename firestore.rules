rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 / Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.uid == userId;
    }

    function isNonNegNum(val) {
      return (val is int || val is float) && val >= 0;
    }

    function isStrLen(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidCurrency(val) {
      return val is string && val in ['USD', 'JPY', 'EUR', 'CNY'];
    }

    function isValidIncoterm(val) {
      return val is string && val in ['EXW', 'FCA', 'FOB', 'CFR', 'CIF', 'CPT', 'CIP', 'DAP', 'DPU', 'DDP'];
    }

    function isValidTransportMode(val) {
      return val is string && val in ['SEA', 'AIR', 'EXPRESS', 'LAND'];
    }

    // Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'companyName',
          'uiLang', 'docLang', 'activeOrderId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'companyName',
          'uiLang', 'docLang', 'activeOrderId', 'contractSettings', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && isStrLen(data.email, 3, 240)
        && isStrLen(data.displayName, 0, 240)
        && isStrLen(data.companyName, 0, 240)
        && data.uiLang in ['zh', 'ja', 'en']
        && data.docLang in ['en', 'ja', 'zh']
        && isStrLen(data.activeOrderId, 0, 128)
        && (
          !('contractSettings' in data) || (
            data.contractSettings is map
            && data.contractSettings.clauses is list
            && data.contractSettings.clauses.size() <= 20
            && isStrLen(data.contractSettings.companyStampLabel, 0, 240)
            && isStrLen(data.contractSettings.defaultDisclaimerText, 0, 1000)
            && (!('companyStampImage' in data.contractSettings) || isStrLen(data.contractSettings.companyStampImage, 0, 180000))
            && (!('signatureImage' in data.contractSettings) || isStrLen(data.contractSettings.signatureImage, 0, 180000))
          )
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomer(data, userId, docId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'code', 'name', 'country', 'address',
          'contactName', 'email', 'phone', 'fax', 'taxOrImporterId',
          'defaultCurrency', 'defaultIncoterm', 'notifyParty', 'customPrices',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'code', 'name', 'country', 'address',
          'contactName', 'email', 'phone', 'fax', 'taxOrImporterId',
          'defaultCurrency', 'defaultIncoterm', 'notifyParty', 'customPrices',
          'documentTemplates', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == docId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isStrLen(data.code, 1, 80)
        && isStrLen(data.name, 1, 240)
        && isStrLen(data.country, 0, 240)
        && isStrLen(data.address, 0, 1000)
        && isStrLen(data.contactName, 0, 240)
        && isStrLen(data.email, 0, 240)
        && isStrLen(data.phone, 0, 240)
        && isStrLen(data.fax, 0, 240)
        && isStrLen(data.taxOrImporterId, 0, 100)
        && isValidCurrency(data.defaultCurrency)
        && isValidIncoterm(data.defaultIncoterm)
        && isStrLen(data.notifyParty, 0, 1000)
        && data.customPrices is list
        && data.customPrices.size() <= 100
        && (
          data.customPrices.size() == 0 || (
            data.customPrices[0] is map
            && data.customPrices[0].keys().hasAll(['productId', 'unitPrice'])
            && data.customPrices[0].keys().hasOnly(['productId', 'unitPrice', 'tieredPrices'])
            && isValidId(data.customPrices[0].productId)
            && isNonNegNum(data.customPrices[0].unitPrice)
            && (
              !('tieredPrices' in data.customPrices[0]) || (
                data.customPrices[0].tieredPrices is list
                && data.customPrices[0].tieredPrices.size() <= 20
              )
            )
          )
        )
        && (
          !('documentTemplates' in data) || (
            data.documentTemplates is list
            && data.documentTemplates.size() <= 3
            && (
              data.documentTemplates.size() == 0 || (
                data.documentTemplates[0] is map
                && isStrLen(data.documentTemplates[0].name, 1, 240)
                && isStrLen(data.documentTemplates[0].fileBase64, 1, 450000)
                && data.documentTemplates[0].fileType in ['xlsx', 'docx']
                && data.documentTemplates[0].docScope in ['invoice', 'packing', 'contract', 'all']
              )
            )
          )
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSupplier(data, userId, docId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'code', 'name', 'country', 'address',
          'contactName', 'email', 'phone', 'fax', 'taxOrExporterId',
          'signatoryName', 'signatoryTitle', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'code', 'name', 'country', 'address',
          'contactName', 'email', 'phone', 'fax', 'taxOrExporterId',
          'signatoryName', 'signatoryTitle', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == docId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isStrLen(data.code, 1, 80)
        && isStrLen(data.name, 1, 240)
        && isStrLen(data.country, 0, 240)
        && isStrLen(data.address, 0, 1000)
        && isStrLen(data.contactName, 0, 240)
        && isStrLen(data.email, 0, 240)
        && isStrLen(data.phone, 0, 240)
        && isStrLen(data.fax, 0, 240)
        && isStrLen(data.taxOrExporterId, 0, 100)
        && isStrLen(data.signatoryName, 0, 240)
        && isStrLen(data.signatoryTitle, 0, 240)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLogistics(data, userId, docId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'code', 'name', 'supportedModes',
          'contactName', 'phone', 'email', 'accountNo',
          'defaultPortOrHub', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'code', 'name', 'supportedModes',
          'contactName', 'phone', 'email', 'accountNo',
          'defaultPortOrHub', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == docId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isStrLen(data.code, 1, 80)
        && isStrLen(data.name, 1, 240)
        && data.supportedModes is list
        && data.supportedModes.size() >= 1
        && data.supportedModes.size() <= 4
        && data.supportedModes.hasOnly(['SEA', 'AIR', 'EXPRESS', 'LAND'])
        && isStrLen(data.contactName, 0, 240)
        && isStrLen(data.phone, 0, 240)
        && isStrLen(data.email, 0, 240)
        && isStrLen(data.accountNo, 0, 240)
        && isStrLen(data.defaultPortOrHub, 0, 240)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBankAccount(data, userId, docId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'label', 'bankName', 'branchName',
          'swiftCode', 'accountName', 'accountNumber', 'currency',
          'bankAddress', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'label', 'bankName', 'branchName',
          'swiftCode', 'accountName', 'accountNumber', 'currency',
          'bankAddress', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == docId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isStrLen(data.label, 1, 240)
        && isStrLen(data.bankName, 1, 240)
        && isStrLen(data.branchName, 0, 240)
        && isStrLen(data.swiftCode, 0, 80)
        && isStrLen(data.accountName, 0, 240)
        && isStrLen(data.accountNumber, 0, 240)
        && isValidCurrency(data.currency)
        && isStrLen(data.bankAddress, 0, 1000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data, userId, docId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'sku', 'nameEn', 'nameLocal',
          'size', 'material', 'surfaceFinish', 'hsCode',
          'unit', 'unitPrice', 'currency', 'tieredPrices', 'unitNetWeightKg',
          'unitGrossWeightKg', 'defaultUnitsPerCarton', 'cartonLengthCm',
          'cartonWidthCm', 'cartonHeightCm', 'originCountry',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'sku', 'nameEn', 'nameLocal',
          'size', 'material', 'surfaceFinish', 'hsCode',
          'unit', 'unitPrice', 'currency', 'tieredPrices', 'unitNetWeightKg',
          'unitGrossWeightKg', 'defaultUnitsPerCarton', 'cartonLengthCm',
          'cartonWidthCm', 'cartonHeightCm', 'originCountry',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == docId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isStrLen(data.sku, 1, 80)
        && isStrLen(data.nameEn, 1, 1000)
        && isStrLen(data.nameLocal, 0, 1000)
        && isStrLen(data.size, 0, 80)
        && isStrLen(data.material, 0, 80)
        && isStrLen(data.surfaceFinish, 0, 80)
        && isStrLen(data.hsCode, 0, 80)
        && isStrLen(data.unit, 1, 40)
        && isNonNegNum(data.unitPrice)
        && isValidCurrency(data.currency)
        && data.tieredPrices is list
        && data.tieredPrices.size() <= 20
        && (
          data.tieredPrices.size() == 0 || (
            data.tieredPrices[0] is map
            && data.tieredPrices[0].keys().hasAll(['minQty', 'maxQty', 'unitPrice'])
            && data.tieredPrices[0].keys().hasOnly(['minQty', 'maxQty', 'unitPrice'])
            && isNonNegNum(data.tieredPrices[0].minQty)
            && (data.tieredPrices[0].maxQty == null || isNonNegNum(data.tieredPrices[0].maxQty))
            && isNonNegNum(data.tieredPrices[0].unitPrice)
          )
        )
        && isNonNegNum(data.unitNetWeightKg)
        && isNonNegNum(data.unitGrossWeightKg)
        && isNonNegNum(data.defaultUnitsPerCarton)
        && isNonNegNum(data.cartonLengthCm)
        && isNonNegNum(data.cartonWidthCm)
        && isNonNegNum(data.cartonHeightCm)
        && isStrLen(data.originCountry, 0, 120)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrderShipping(s) {
      return s is map
        && s.keys().hasAll([
          'mode', 'logisticsProviderId', 'incoterm', 'incotermPlace',
          'portOfLoading', 'portOfDischarge', 'vesselOrFlightOrCourier',
          'trackingOrBlNo', 'etd', 'eta', 'shippingMarksMain', 'caseNumberPrefix'
        ])
        && s.keys().hasOnly([
          'mode', 'logisticsProviderId', 'incoterm', 'incotermPlace',
          'portOfLoading', 'portOfDischarge', 'vesselOrFlightOrCourier',
          'trackingOrBlNo', 'etd', 'eta', 'shippingMarksMain', 'caseNumberPrefix'
        ])
        && isValidTransportMode(s.mode)
        && isStrLen(s.logisticsProviderId, 0, 128)
        && isValidIncoterm(s.incoterm)
        && isStrLen(s.incotermPlace, 0, 240)
        && isStrLen(s.portOfLoading, 0, 240)
        && isStrLen(s.portOfDischarge, 0, 240)
        && isStrLen(s.vesselOrFlightOrCourier, 0, 240)
        && isStrLen(s.trackingOrBlNo, 0, 240)
        && isStrLen(s.etd, 0, 40)
        && isStrLen(s.eta, 0, 40)
        && isStrLen(s.shippingMarksMain, 0, 240)
        && isStrLen(s.caseNumberPrefix, 0, 80);
    }

    function isValidOrderCosts(c) {
      return c is map
        && c.keys().hasAll([
          'packingHandlingCost', 'inlandFreightCost', 'mainFreightCost',
          'insuranceMode', 'insuranceManualCost', 'insuranceRatePercent',
          'destinationHandlingCost', 'importDutyTaxCost'
        ])
        && c.keys().hasOnly([
          'packingHandlingCost', 'inlandFreightCost', 'mainFreightCost',
          'insuranceMode', 'insuranceManualCost', 'insuranceRatePercent',
          'destinationHandlingCost', 'importDutyTaxCost'
        ])
        && isNonNegNum(c.packingHandlingCost)
        && isNonNegNum(c.inlandFreightCost)
        && isNonNegNum(c.mainFreightCost)
        && c.insuranceMode in ['MANUAL', 'AUTO_PERCENT']
        && isNonNegNum(c.insuranceManualCost)
        && isNonNegNum(c.insuranceRatePercent)
        && isNonNegNum(c.destinationHandlingCost)
        && isNonNegNum(c.importDutyTaxCost);
    }

    function isValidOrder(data, userId, docId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'invoiceNo', 'poNo', 'orderDate', 'paymentTerms',
          'currency', 'exchangeRate', 'supplierId', 'customerId', 'billToCustomerId', 'bankAccountId',
          'itemHeader', 'palletCount', 'emptyCartons', 'cartonsPerLayer', 'palletVolumeDetails',
          'surfaceFootnotes', 'packingRows',
          'items', 'shipping', 'costs', 'remarks',
          'orderCreatedAt', 'orderUpdatedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'invoiceNo', 'poNo', 'orderDate', 'paymentTerms',
          'currency', 'exchangeRate', 'supplierId', 'customerId', 'billToCustomerId', 'bankAccountId',
          'itemHeader', 'palletCount', 'emptyCartons', 'cartonsPerLayer', 'palletVolumeDetails',
          'surfaceFootnotes', 'packingRows',
          'items', 'shipping', 'costs', 'remarks',
          'docOverrides', 'docSpecialFields',
          'orderCreatedAt', 'orderUpdatedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == docId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isStrLen(data.invoiceNo, 1, 100)
        && isStrLen(data.poNo, 0, 100)
        && isStrLen(data.orderDate, 0, 40)
        && isStrLen(data.paymentTerms, 0, 240)
        && isValidCurrency(data.currency)
        && isNonNegNum(data.exchangeRate)
        && data.exchangeRate > 0
        && isStrLen(data.supplierId, 0, 128)
        && isStrLen(data.customerId, 0, 128)
        && isStrLen(data.billToCustomerId, 0, 128)
        && isStrLen(data.bankAccountId, 0, 128)
        && isStrLen(data.itemHeader, 0, 240)
        && isNonNegNum(data.palletCount)
        && isNonNegNum(data.emptyCartons)
        && isNonNegNum(data.cartonsPerLayer)
        && data.cartonsPerLayer >= 1
        && isStrLen(data.palletVolumeDetails, 0, 1000)
        && isStrLen(data.surfaceFootnotes, 0, 1000)
        && data.packingRows is list
        && data.packingRows.size() <= 100
        && (
          data.packingRows.size() == 0 || (
            data.packingRows[0] is map
            && isStrLen(data.packingRows[0].palletNo, 0, 80)
            && isStrLen(data.packingRows[0].ctnNo, 0, 80)
            && isNonNegNum(data.packingRows[0].qty)
          )
        )
        && data.items is list
        && data.items.size() <= 50
        && (
          data.items.size() == 0 || (
            data.items[0] is map
            && isStrLen(data.items[0].sku, 0, 80)
            && isStrLen(data.items[0].description, 0, 1000)
            && isNonNegNum(data.items[0].quantity)
            && isNonNegNum(data.items[0].unitPrice)
          )
        )
        && isValidOrderShipping(data.shipping)
        && isValidOrderCosts(data.costs)
        && isStrLen(data.remarks, 0, 1000)
        && (!('docOverrides' in data) || (data.docOverrides is map && data.docOverrides.keys().size() <= 60))
        && (!('docSpecialFields' in data) || (data.docSpecialFields is map && data.docSpecialFields.keys().size() <= 10))
        && isStrLen(data.orderCreatedAt, 0, 64)
        && isStrLen(data.orderUpdatedAt, 0, 64)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data, userId, docId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'timestamp', 'action', 'targetLabel',
          'summary', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'timestamp', 'action', 'targetLabel',
          'summary', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == docId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isStrLen(data.timestamp, 1, 64)
        && data.action in [
          'CREATE_ORDER', 'UPDATE_ORDER', 'DELETE_ORDER',
          'DUPLICATE_ORDER', 'MASTER_UPDATE', 'RESTORE_BACKUP'
        ]
        && isStrLen(data.targetLabel, 0, 240)
        && isStrLen(data.summary, 0, 1000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // User Workspace Root Document (PII strictly private to owner)
    match /users/{userId} {
      allow get: if isVerifiedOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['uiLang', 'docLang', 'activeOrderId', 'contractSettings', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'companyName', 'updatedAt'])
        );
      allow delete: if false;

      match /customers/{customerId} {
        allow get: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(customerId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(customerId)
          && isValidCustomer(incoming(), userId, customerId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(customerId)
          && isValidCustomer(incoming(), userId, customerId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'code', 'name', 'country', 'address', 'contactName',
            'email', 'phone', 'fax', 'taxOrImporterId', 'defaultCurrency',
            'defaultIncoterm', 'notifyParty', 'customPrices', 'documentTemplates', 'updatedAt'
          ]);
        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(customerId);
      }

      match /suppliers/{supplierId} {
        allow get: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(supplierId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(supplierId)
          && isValidSupplier(incoming(), userId, supplierId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(supplierId)
          && isValidSupplier(incoming(), userId, supplierId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'code', 'name', 'country', 'address', 'contactName',
            'email', 'phone', 'fax', 'taxOrExporterId', 'signatoryName',
            'signatoryTitle', 'updatedAt'
          ]);
        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(supplierId);
      }

      match /logisticsProviders/{providerId} {
        allow get: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(providerId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(providerId)
          && isValidLogistics(incoming(), userId, providerId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(providerId)
          && isValidLogistics(incoming(), userId, providerId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'code', 'name', 'supportedModes', 'contactName',
            'phone', 'email', 'accountNo', 'defaultPortOrHub', 'updatedAt'
          ]);
        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(providerId);
      }

      match /bankAccounts/{bankId} {
        allow get: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(bankId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(bankId)
          && isValidBankAccount(incoming(), userId, bankId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(bankId)
          && isValidBankAccount(incoming(), userId, bankId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'label', 'bankName', 'branchName', 'swiftCode',
            'accountName', 'accountNumber', 'currency', 'bankAddress', 'updatedAt'
          ]);
        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(bankId);
      }

      match /products/{productId} {
        allow get: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(productId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(productId)
          && isValidProduct(incoming(), userId, productId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(productId)
          && isValidProduct(incoming(), userId, productId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'sku', 'nameEn', 'nameLocal', 'size', 'material', 'surfaceFinish',
            'hsCode', 'unit', 'unitPrice', 'currency', 'tieredPrices', 'unitNetWeightKg',
            'unitGrossWeightKg', 'defaultUnitsPerCarton', 'cartonLengthCm',
            'cartonWidthCm', 'cartonHeightCm', 'originCountry', 'updatedAt'
          ]);
        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(productId);
      }

      match /orders/{orderId} {
        allow get: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(orderId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(orderId)
          && isValidOrder(incoming(), userId, orderId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(orderId)
          && isValidOrder(incoming(), userId, orderId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'invoiceNo', 'poNo', 'orderDate', 'paymentTerms', 'currency', 'exchangeRate',
            'supplierId', 'customerId', 'billToCustomerId', 'bankAccountId',
            'itemHeader', 'palletCount', 'emptyCartons', 'cartonsPerLayer', 'palletVolumeDetails',
            'surfaceFootnotes', 'packingRows', 'items',
            'shipping', 'costs', 'remarks', 'docOverrides', 'docSpecialFields',
            'orderCreatedAt', 'orderUpdatedAt', 'updatedAt'
          ]);
        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(orderId);
      }

      match /auditLogs/{logId} {
        allow get: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(logId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(logId)
          && isValidAuditLog(incoming(), userId, logId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(logId);
      }
    }
  }
}
